LLMAPT_ENVIRONMENT=development
LLMAPT_DEBUG=false
LLMAPT_LOG_LEVEL=INFO
LLMAPT_LOG_FORMAT=console
LLMAPT_API_HOST=0.0.0.0
LLMAPT_API_PORT=8000
LLMAPT_WORKER_CONCURRENCY=2

# Local development credentials only. Replace all values outside a developer laptop.
POSTGRES_DB=llmapt
POSTGRES_USER=llmapt
POSTGRES_PASSWORD=local-postgres-change-me
RABBITMQ_DEFAULT_USER=llmapt
RABBITMQ_DEFAULT_PASS=local-rabbitmq-change-me
MINIO_ROOT_USER=llmapt
MINIO_ROOT_PASSWORD=local-minio-change-me-now

LLMAPT_DATABASE_URL=postgresql+asyncpg://llmapt:local-postgres-change-me@postgres:5432/llmapt
LLMAPT_BROKER_URL=amqp://llmapt:local-rabbitmq-change-me@rabbitmq:5672//
LLMAPT_REDIS_URL=redis://redis:6379/0
LLMAPT_OBJECT_STORE_ENDPOINT=http://minio:9000
LLMAPT_OBJECT_STORE_BUCKET=llmapt-artifacts

# External model calls are disabled by default. Never commit a real API key.
LLMAPT_EXTERNAL_MODEL_CALLS_ENABLED=false
LLMAPT_MODEL_PROVIDER_KEY=external
LLMAPT_MODEL_PROVIDER_NAME=openai-compatible
LLMAPT_MODEL_NAME=
LLMAPT_MODEL_REVISION=
LLMAPT_MODEL_API_ENDPOINT=
LLMAPT_MODEL_API_KEY=
LLMAPT_MODEL_TIMEOUT_SECONDS=60
LLMAPT_RUNNER_URL=http://runner:8080
LLMAPT_RUNNER_TOKEN=local-runner-change-me
LLMAPT_RUNNER_TIMEOUT_SECONDS=35
# M3 local workspace authentication. Change these before sharing a running instance.
LLMAPT_AUTH_SECRET=local-auth-secret-change-me
LLMAPT_BOOTSTRAP_ADMIN_USERNAME=admin
LLMAPT_BOOTSTRAP_ADMIN_PASSWORD=llmapt-local-change-me
LLMAPT_BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Administrator
LLMAPT_ACCESS_TOKEN_TTL_MINUTES=480
LLMAPT_GUEST_TOKEN_TTL_MINUTES=120
